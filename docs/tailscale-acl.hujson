// Политика доступа Tailscale для сервера с CRM.
//
// Куда вставлять: admin console → Access Controls → заменить содержимое → Save.
// Формат HuJSON: комментарии и висящие запятые разрешены, это не строгий JSON.
//
// Задача: свои устройства ходят куда угодно, а гость, которому расшарен
// сервер, видит ровно один сервис — веб-интерфейс CRM. Без этого правила
// гость получает доступ ко ВСЕМ портам машины, включая Portainer (:9443,
// монтирует docker.sock — это root на сервере), AdGuard, Vaultwarden,
// SSH :22 и postgres, если он когда-нибудь будет опубликован.
{
	"hosts": {
		// tailnet-адрес сервера. Он постоянный, в отличие от адреса в локальной
		// сети: посмотреть можно командой `tailscale ip -4` на сервере.
		"crm-server": "100.96.128.15",
	},

	"acls": [
		// 1. Свои устройства (всё, что вошло под вашим аккаунтом) — полный доступ.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["*:*"],
		},

		// 2. Гости — те, кому машина расшарена через Share. Только CRM:
		//    80 — http внутри tailnet, 443 — https от `tailscale serve`.
		{
			"action": "accept",
			"src":    ["autogroup:shared"],
			"dst":    ["crm-server:80,443"],
		},
	],

	// Тестов намеренно нет: в них нужны конкретные адреса аккаунтов, а
	// проверить политику проще фактом — гость открывает https://homeserver.
	// tail7fea85.ts.net (работает) и https://<tailnet-IP>:9443 (не открывается).
}
