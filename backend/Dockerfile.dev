FROM python:3.12-slim

WORKDIR /app

# только runtime-библиотеки WeasyPrint; компиляторы не нужны (все пакеты — wheel'ы)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libcairo2 libpango-1.0-0 libpangocairo-1.0-0 libgdk-pixbuf-2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# uid 1000 совпадает с пользователем хоста — бинд-маунт ./backend:/app остаётся записываемым
RUN useradd --create-home --uid 1000 app

COPY requirements/ ./requirements/
RUN pip install --no-cache-dir -r requirements/development.txt -c requirements/constraints.txt

RUN mkdir -p /app/media && chown app:app /app/media

USER app

# логи долгоживущих процессов (бот, runserver) не должны застревать в буфере
ENV PYTHONUNBUFFERED=1

EXPOSE 8000
