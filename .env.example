# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database
DATABASE_URL=postgres://postgres:postgres@db:5432/legal_crm
POSTGRES_DB=legal_crm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Telegram (опционально) — токен бота для уведомлений. Пусто = отключено.
TELEGRAM_BOT_TOKEN=

# Email (опционально) — SMTP для отправки счетов клиентам.
# Без настроек письма печатаются в лог backend-контейнера (console backend).
# Яндекс: smtp.yandex.ru, порт 465, EMAIL_USE_SSL=True (нужен «пароль приложения»)
# Gmail:  smtp.gmail.com, порт 587, EMAIL_USE_TLS=True (нужен «app password»)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=firm@yandex.ru
# EMAIL_HOST_PASSWORD=app-password
# DEFAULT_FROM_EMAIL=firm@yandex.ru

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Storage
USE_S3=False
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio-password
MINIO_STORAGE_BUCKET_NAME=legal-crm-media
AWS_S3_ACCESS_KEY_ID=admin
AWS_S3_SECRET_ACCESS_KEY=minio-password
AWS_STORAGE_BUCKET_NAME=legal-crm-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1
